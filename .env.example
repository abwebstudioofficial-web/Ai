# =============================================================================
# Site Agent - optional Edge Function secrets
# =============================================================================
# NORMALLY NOT NEEDED: Site Agent reads its settings from public.agent_settings and its
# secrets from Supabase Vault ("site_agent_..." names) - see HANDOFF.md step 3.
# Anything set here overrides the database. To use it:
#   supabase secrets set --project-ref zonuxfqvyxhfkimdahkb --env-file ./site-agent.env
# (copy this file to site-agent.env, fill it in, and NEVER commit the filled-in copy)
#
# SUPABASE_URL, SUPABASE_ANON_KEY, SUPABASE_SERVICE_ROLE_KEY and SUPABASE_DB_URL are
# provided to Edge Functions automatically - don't set them.
# =============================================================================

# --- Required -----------------------------------------------------------------
# Claude API key from https://console.anthropic.com (set a monthly spend limit there)
ANTHROPIC_API_KEY=
# Random string (at least 32 characters) shared by the functions and pg_cron.
# Generate with:  openssl rand -hex 32
# The SAME value must also be stored in Supabase Vault as "site_agent_internal_secret".
AGENT_INTERNAL_SECRET=
# The live website (GitHub Pages URL or custom domain), no trailing slash
SITE_URL=
# Optional extra pages to check every 15 minutes, comma separated (e.g. /fleet_drivers.html)
SITE_KEY_PATHS=/fleet_drivers.html

# --- How much the agent may do on its own ----------------------------------------
# readonly  (default) every change waits for your one-click approval
# standard  small data fixes (1 statement, <= AGENT_MAX_AUTO_ROWS rows) and pull requests run
#           automatically; deletes, bulk changes and schema migrations need approval
# full      no approvals, except anything touching pg_cron / auth / storage / vault
AGENT_AUTONOMY=readonly
AGENT_MAX_AUTO_ROWS=25
AGENT_MAX_TURNS_PER_RUN=30

# --- AI cost control ----------------------------------------------------------------
# The morning check and the 15-minute monitor are rule-based and FREE. The only automatic
# AI use is one short call that explains a NEW problem (never repeated for the same one).
AI_EXPLAIN_PROBLEMS=true
AI_AUTO_MODEL=claude-haiku-4-5
# Hard monthly cap on estimated Claude spend (US$). When reached, all Site Agent AI calls stop
# until next month; checks, reports and alerts keep working. 0 = no cap.
AI_MONTHLY_BUDGET_USD=5

# --- Question model (only used if someone sends the Telegram bot a question) ------------
AGENT_MODEL=claude-sonnet-5
# low | medium | high | xhigh | max  (higher = more thorough, more expensive)
AGENT_EFFORT=medium
AGENT_MAX_TOKENS=16000
AGENT_ENABLE_WEB_SEARCH=true
# Server-side refusal fallback and conversation compaction (set false if the API ever rejects them)
AGENT_ENABLE_FALLBACKS=true
AGENT_ENABLE_COMPACTION=true

# --- Edge Function time limit ------------------------------------------------------
# Free plan: 150000 (150s). Pro/paid plans: 400000.
AGENT_WALL_CLOCK_MS=150000

# --- Optional: Supabase logs + security/performance advisors -----------------------
# Personal access token from https://supabase.com/dashboard/account/tokens
AGENT_SUPABASE_PAT=

# --- Optional: code access for fix pull requests ------------------------------------
# Fine-grained token limited to the logistix repo: Contents read/write, Pull requests
# read/write, Commit statuses read. Protect `main` on GitHub (require a pull request) so
# even this token can't push to main. The agent never merges - you do.
GITHUB_TOKEN=
GITHUB_REPO=abwebstudioofficial-web/logistix
GITHUB_DEFAULT_BRANCH=main

# --- Notifications (configure any you want; unset channels are skipped) ------------------
# Only alerts at this level or above are pushed immediately (reports/approvals always are)
NOTIFY_MIN_SEVERITY=warning
# Link included in messages
AGENT_DASHBOARD_URL=

# Telegram (recommended: free, two-way - chat with the agent and /approve from your phone)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_IDS=
TELEGRAM_WEBHOOK_SECRET=

# Email via Resend (https://resend.com)
RESEND_API_KEY=
ALERT_EMAIL_FROM=Site Agent <alerts@yourdomain.com>
ALERT_EMAIL_TO=

# SMS / WhatsApp via Twilio (WhatsApp business-initiated messages need approved templates)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=
ALERT_PHONE_TO=

# Slack or Discord incoming webhook
ALERT_WEBHOOK_URL=
